# ===== 环境变量模板 =====
# 复制本文件为 .env 并按需填写。生产环境务必全部配置。

# 调试模式：开发 True，生产 False
DEBUG=False

# 安全密钥：用下面命令生成一个随机密钥，粘贴到这里
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=请替换为随机密钥

# 允许访问的域名，逗号分隔（换成你自己的域名）
ALLOWED_HOSTS=example.com,www.example.com

# 数据库连接（生产用 MySQL，本地不填则默认 SQLite）
# 格式：mysql://用户名:密码@127.0.0.1:3306/数据库名
# DATABASE_URL=mysql://user:password@127.0.0.1:3306/resource_share

# 是否已启用 HTTPS（部署 SSL 证书后设为 True，自动开启安全设置）
HTTPS_ON=False
